# =========================================================
# Project 4: Deep Learning Systems
# Tracked: notebook, report, figures, metrics, data/README.md,
#          data/splits.csv, requirements.txt
# =========================================================

# --- Dataset (≈540 MB; the notebook downloads/rebuilds it) ---
/data/*
!/data/README.md
!/data/splits.csv

# --- Model weights (regenerated by training) ---
/outputs/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments & secrets ---
.venv/
venv/
env/
.env
.env.*

# --- Jupyter ---
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Office / LaTeX temp files ---
~$*
*.tmp

# --- Logs & scratch ---
*.log
runs/
wandb/
lightning_logs/

# --- OS ---
.DS_Store
._*
Thumbs.db

# --- Editors & tools ---
.vscode/
.idea/
*.swp
.claude/settings.local.json
